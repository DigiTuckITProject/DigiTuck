{
  "name": "digituck-vendor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @digituck/contracts && concurrently -k -n contracts,api,web \"npm run dev -w @digituck/contracts\" \"npm run dev -w @digituck/api\" \"vite --host 127.0.0.1\"",
    "build": "npm run build -w @digituck/contracts && npm run build -w @digituck/api && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node scripts/start.mjs",
    "typecheck": "npm run build -w @digituck/contracts && tsc -p tsconfig.check.json --noEmit",
    "test": "npm run build -w @digituck/contracts && vitest run --config vitest.config.ts",
    "test:db": "npm run build -w @digituck/contracts && vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:rollback": "tsx scripts/database.ts rollback",
    "db:seed": "tsx scripts/database.ts seed",
    "db:check": "tsx scripts/database.ts check",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "db:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "orders:expire": "tsx scripts/expire-orders.ts"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@digituck/contracts": "0.1.0",
    "@tanstack/react-query": "5.106.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "vite": "8.3.6",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/express-mysql-session": "3.0.8",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0 <27"
  },
  "packageManager": "npm@11.18.0"
}
